<Window x:Class="ScreenTranslate.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="屏幕字幕翻译" Width="460" Height="440" MinWidth="420" MinHeight="400" WindowStartupLocation="CenterScreen" Background="#F4F6FA">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="屏幕字幕翻译" FontSize="23" FontWeight="SemiBold" Foreground="#172033" />
      <TextBlock Text="框选字幕区域，实时识别英文并离线翻译为简体中文" Margin="0,5,0,0" Foreground="#68748A" TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="1" Margin="0,18,0,8" Padding="12" CornerRadius="8" Background="White" BorderBrush="#DFE4ED" BorderThickness="1">
      <DockPanel>
        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#91A0B7" DockPanel.Dock="Left" Margin="0,0,9,0" />
        <TextBlock x:Name="StatusText" Text="就绪" Foreground="#354158" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
      <Button x:Name="SelectButton" Content="框选字幕区域" Click="SelectButton_Click" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" />
      <Button x:Name="StartButton" Content="开始翻译" Click="StartButton_Click" IsEnabled="False" />
      <Button x:Name="PauseButton" Content="暂停" Click="PauseButton_Click" IsEnabled="False" />
      <Button x:Name="StopButton" Content="停止" Click="StopButton_Click" IsEnabled="False" />
    </StackPanel>
    <Border Grid.Row="3" Margin="0,12,0,10" Padding="14" CornerRadius="8" Background="White" BorderBrush="#DFE4ED" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="翻译方式" FontWeight="SemiBold" Foreground="#263248" />
        <ComboBox x:Name="TranslationMode" Width="250" HorizontalAlignment="Left" Margin="0,7,0,12" SelectedIndex="0" SelectionChanged="TranslationMode_SelectionChanged">
          <ComboBoxItem Content="本地 ONNX 模型（离线）" />
          <ComboBoxItem Content="Google 翻译网页（联网备用）" />
        </ComboBox>
        <TextBlock Text="译文悬浮窗" FontWeight="SemiBold" Foreground="#263248" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <TextBlock Text="字体大小" VerticalAlignment="Center" Foreground="#68748A" />
          <Slider x:Name="FontSlider" Minimum="18" Maximum="36" Value="24" Width="140" Margin="12,0,0,0" ValueChanged="FontSlider_ValueChanged" />
          <TextBlock x:Name="FontValue" Text="24" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock Text="背景透明度" VerticalAlignment="Center" Foreground="#68748A" />
          <Slider x:Name="OpacitySlider" Minimum="45" Maximum="100" Value="92" Width="140" Margin="12,0,0,0" ValueChanged="OpacitySlider_ValueChanged" />
          <TextBlock x:Name="OpacityValue" Text="92%" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="4" Text="本地模式不上传；Google 备用模式会将识别文字发送至 Google。" Foreground="#78849A" FontSize="12" VerticalAlignment="Center" />
    <wv2:WebView2 x:Name="LocalModelBrowser" Grid.Row="4" Width="1" Height="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
  </Grid>
</Window>
