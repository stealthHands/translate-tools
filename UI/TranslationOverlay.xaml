<Window x:Class="ScreenTranslate.UI.TranslationOverlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="实时译文" Width="560" Height="150" MinWidth="320" MinHeight="90" WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterScreen">
  <Border x:Name="Surface" CornerRadius="10" Background="#EB101722" Padding="10" BorderBrush="#445A6B81" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" LastChildFill="True" Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Button x:Name="CollapseButton" DockPanel.Dock="Right" Content="−" Width="28" Height="24" Margin="0" Padding="0" BorderThickness="0" Background="Transparent" Foreground="White" FontSize="20" ToolTip="最小化/还原" Click="CollapseButton_Click" />
        <TextBlock Text="实时译文" Foreground="#BFCADA" VerticalAlignment="Center" FontSize="12" />
      </DockPanel>
      <ScrollViewer x:Name="TranslationContent" Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="TranslationText" Text="译文将在这里显示" Foreground="White" FontSize="24" TextWrapping="Wrap" />
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
